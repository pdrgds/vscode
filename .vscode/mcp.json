{
	"servers": {
		"vscode-automation-mcp": {
			"type": "stdio",
			"command": "npm",
			"args": [
				"run",
				"start-stdio"
			],
			"cwd": "${workspaceFolder}/test/mcp"
		},
		"component-explorer": {
			"type": "stdio",
			"command": "npx",
			"cwd": "${workspaceFolder}/build/vite",
			"args": [
				"component-explorer",
				"mcp",
				"-c",
				"./component-explorer.json"
			]
		}
	},
	"inputs": []
}
